{
  "name": "orbit-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Orbit MCP server for Claude Code: lets Claude track its work as Orbit work items. Runs locally over stdio.",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "build": "esbuild src/index.js --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "test:dist": "ORBIT_MCP_ENTRY=dist/index.js node --test test/e2e.test.js",
    "inspect": "npx @modelcontextprotocol/inspector node src/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "marked": "18.0.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
